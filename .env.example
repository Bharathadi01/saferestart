# SafeRestart Environment Configuration Example
# Copy to .env.local for local development overrides
# In AWS Amplify Hosting production: NO static credentials or bearer tokens are required.
# Production uses the Amplify SSR Compute IAM Execution Role automatically via SigV4.

# Node Environment
NODE_ENV=development

# AWS Region (Defaults to ap-southeast-2 for Bedrock Nova Micro Playground)
AWS_REGION=ap-southeast-2

# Amazon Bedrock Model Configuration (Defaults to amazon.nova-micro-v1:0)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Production AWS IAM Role / Default Credential Provider Chain
# In AWS Amplify Hosting or ECS/Lambda, role-based auth is automatically discovered.
# To test role-based auth locally (e.g. via AWS CLI profile or SSO), set:
# AWS_USE_IAM_ROLE=true

# Amazon Bedrock API Key / Bearer Token Authentication (For local testing)
# Set your temporary Bedrock API key here or in terminal: export AWS_BEARER_TOKEN_BEDROCK="..."
# AWS_BEARER_TOKEN_BEDROCK=

# AWS Credentials (SigV4 static keys alternative - leave empty for IAM role or bearer token)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Storage & Persistence (Defaults to false / in-memory until real tables are provisioned)
USE_DYNAMODB=false
# ZONES_TABLE=saferestart-zones-dev
# RESTART_EVENTS_TABLE=saferestart-events-dev
# AUDIT_TRAIL_TABLE=saferestart-audit-dev

# Amazon S3 Field Evidence Bucket
# EVIDENCE_BUCKET=saferestart-evidence-123456789012-dev

# Amazon EventBridge Custom Event Bus
# EVENT_BUS_NAME=saferestart-bus-dev
