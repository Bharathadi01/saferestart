# SafeRestart Environment Configuration Example
# Copy to .env.local for local overrides

# Node Environment
NODE_ENV=development

# AWS Region (Defaults to ap-southeast-2 for Bedrock Nova Micro Playground)
AWS_REGION=ap-southeast-2

# Amazon Bedrock Model Configuration (Defaults to amazon.nova-micro-v1:0)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Amazon Bedrock API Key / Bearer Token Authentication (Recommended for local dev)
# Set your temporary Bedrock API key here or in terminal: export AWS_BEARER_TOKEN_BEDROCK="..."
# AWS_BEARER_TOKEN_BEDROCK=

# AWS Credentials (SigV4 Alternative - leave empty if using bearer token or local simulator mode)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Amazon DynamoDB Table Names (Configured when deploying AWS SAM stack)
# ZONES_TABLE=saferestart-zones-dev
# RESTART_EVENTS_TABLE=saferestart-events-dev
# AUDIT_TRAIL_TABLE=saferestart-audit-dev

# Amazon S3 Field Evidence Bucket
# EVIDENCE_BUCKET=saferestart-evidence-123456789012-dev

# Amazon EventBridge Custom Event Bus
# EVENT_BUS_NAME=saferestart-bus-dev
